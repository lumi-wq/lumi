DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/lumi"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/lumi"
JWT_SECRET="change-me"

# Оплата: mock | monobank (plata by mono)
# Dev без банку: mock
# Dev з тестовим Monopay: monobank + токен з https://api.monobank.ua/
# Production: monobank + бойовий токен з https://web.monobank.ua/
PAYMENT_PROVIDER="mock"
MONOBANK_TOKEN=""
# Лише для локальних тестів webhook (не використовуйте на production)
# MONOBANK_SKIP_WEBHOOK_VERIFY="1"

NOVA_POSHTA_API_KEY=""
# Опційно: CityRef Сокирян (інакше резолвиться через API)
# NOVA_POSHTA_SENDER_CITY_REF=""
# Для webhook Monobank має бути публічний HTTPS (на local — ngrok/cloudflared)
# Production обовʼязково: https://lumi.kids (не тунель і не *.vercel.app)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Фото товарів на Vercel: Storage → Blob → Create.
# Для вітрини краще Public store (BLOB_ACCESS=public). Private store теж працює —
# тоді фото віддаються через /api/media/....
# Локально можна не ставити — файли пишуться в public/uploads.
# BLOB_READ_WRITE_TOKEN=""
# BLOB_ACCESS="private"

# Checkout: true — можна оформлювати замовлення. Без цієї змінної або false — лише каталог.
# На production залиште false, поки не готові оплата й процеси.
NEXT_PUBLIC_ORDERS_ENABLED="false"
